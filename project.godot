; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Romance Jam 2026"
run/main_scene="uid://ds2mjmfy10p46"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*uid://rle3tpmjvmu7"
DialogueManager="*uid://c3rodes2l3gxb"

[debug]

gdscript/warnings/untyped_declaration=1

[dialogue_manager]

runtime/balloon_path="uid://ds7f863wnj4n2"
editor/advanced/custom_test_scene_path="uid://c0k08mshqoaeu"
runtime/state_autoload_shortcuts=["GameState"]

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

